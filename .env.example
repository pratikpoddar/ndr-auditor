# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel.trycloudflare.com
# read_all_orders is requested only for a true 90-day backfill and needs Shopify approval.
# Ship without it and show the honest 60-day window until it is granted.
SCOPES=read_orders,read_fulfillments,write_fulfillments

# --- Database ---
DATABASE_URL=postgresql://ndr:ndr@localhost:5432/ndrauditor

# --- Crypto ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- Alerts ---
# console | twilio | meta   (console is the demo-safe default: logs, never sends)
ALERT_PROVIDER=console
DEMO_MERCHANT_WHATSAPP=whatsapp:+910000000000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_ALERT_TEMPLATE=
