# Template for shopify.app.toml.
#
# Named `shopify.app.toml.example`, NOT `shopify.app.example.toml`, on purpose: the Shopify
# CLI globs `shopify.app*.toml` and will happily adopt a file named the second way as your
# real config, then write your live client_id into it. Which is exactly what happened once.
#
# Setup:
#   cp shopify.app.toml.example shopify.app.toml
#   npx shopify app config link
#
# The scope and webhook choices below are product decisions, not boilerplate — keep them in
# sync here when you change them, since this file is what a new contributor starts from.

# Learn more about configuring your app at https://shopify.dev/docs/apps/tools/cli/configuration

client_id = ""
name = "NDR Auditor"
application_url = "https://example.com"
embedded = true

[build]
automatically_update_urls_on_dev = true
include_config_on_deploy = true

[webhooks]
api_version = "2026-10"

[access_scopes]
# read_orders alone covers orders, fulfillments, trackingInfo and the fulfillment event
# timeline — verified against the live 2026-10 schema, so read_fulfillments is not requested.
#
# fulfillmentTrackingInfoUpdate does NOT accept write_fulfillments; Shopify requires a
# fulfillment-order write scope. Both are requested because Indian merchants split between
# self-fulfilled orders (merchant-managed) and aggregator-created ones such as Shiprocket or
# Delhivery (third-party), and the carrier-name correction has to work for both.
#
# read_all_orders is deliberately absent: it needs Shopify approval, and the app must work
# honestly on a 60-day window without it.
scopes = "read_orders,write_merchant_managed_fulfillment_orders,write_third_party_fulfillment_orders"

[auth]
redirect_urls = [ "https://shopify.dev/apps/default-app-home/api/auth" ]
